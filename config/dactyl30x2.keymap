#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE     &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3      &kp NUMBER_4  &kp N5        &kp NUMBER_6   &kp N7       &kp N8             &kp N9           &kp N0              &kp SINGLE_QUOTE
&kp PLUS       &kp Q           &kp W           &kp E             &kp R         &kp T         &kp Y          &kp U        &kp I              &kp O            &kp P               &kp GRAVE
&kp BACKSLASH  &hm LEFT_ALT A  &hm LEFT_WIN S  &hm LEFT_SHIFT D  &hm LCTRL F   &kp G         &kp H          &hm RCTRL J  &hm RIGHT_SHIFT K  &hm RIGHT_WIN L  &hm RIGHT_ALT SEMI  &kp LEFT_BRACKET
&kp MINUS      &kp Z           &kp X           &kp C             &kp V         &kp B         &kp N          &kp M        &kp COMMA          &kp DOT          &kp FSLH            &kp RIGHT_BRACKET
&kp LCTRL      &kp LEFT_ALT    &kp LEFT_SHIFT  &lt 2 TAB         &lt 3 SPACE   &lt 1 ESCAPE  &kp BACKSPACE  &kp ENTER    &kp ESCAPE         &kp RIGHT_SHIFT  &kp RIGHT_ALT       &kp RCTRL
            >;
        };

        fn {
            bindings = <
&none       &kp F1  &kp F2       &kp F3         &kp F4          &kp F5          &kp F6    &kp F7    &kp F8  &kp F9     &kp F10  &kp F11
&none       &none   &kp HOME     &kp END        &none           &kp CAPSLOCK    &kp N6    &kp N7    &kp N8  &kp N9     &kp N0   &kp F12
&caps_word  &none   &kp PAGE_UP  &kp PAGE_DOWN  &none           &kp CAPS        &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none    &none
&none       &none   &none        &none          &studio_unlock  &studio_unlock  &kp N1    &kp N2    &kp N3  &kp N4     &kp N5   &none
&none       &none   &none        &none          &none           &none           &none     &none     &none   &none      &none    &none
            >;
        };

        music_bluetooth {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none           &none           &none             &none     &none      &none
&none  &bt BT_CLR    &none         &none         &none         &bt BT_CLR_ALL  &none           &kp C_PREVIOUS  &kp C_NEXT        &none     &none      &none
&none  &none         &none         &none         &none         &none           &none           &kp C_MUTE      &kp C_PLAY_PAUSE  &none     &none      &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none           &none           &none             &none     &none      &none
&mo 3  &kp SPACE     &to 0         &none         &none         &studio_unlock  &studio_unlock  &none           &none             &kp LGUI  &kp ENTER  &kp ESC
            >;
        };

        mouse {
            bindings = <
&none  &none  &none      &none      &none      &none  &none           &none           &none         &none            &none           &none
&none  &none  &mkp MCLK  &mkp LCLK  &mkp RCLK  &none  &none           &none           &mkp LCLK     &mkp RCLK        &none           &none
&none  &none  &mkp MCLK  &mkp LCLK  &mkp RCLK  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_UP    &none
&none  &none  &none      &none      &none      &none  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &msc SCRL_DOWN  &none
&none  &none  &none      &none      &none      &none  &none           &none           &none         &none            &none           &none
            >;
        };

        layer_5 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_6 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_7 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_8 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_9 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_10 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };
    };
};
