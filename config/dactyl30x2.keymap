#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE     &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3      &kp NUMBER_4  &kp N5        &kp NUMBER_6   &kp N7       &kp N8             &kp N9           &kp N0              &kp SINGLE_QUOTE
&kp PLUS       &kp Q           &kp W           &kp E             &kp R         &kp T         &kp Y          &kp U        &kp I              &kp O            &kp P               &kp GRAVE
&kp BACKSLASH  &hm LEFT_ALT A  &hm LEFT_WIN S  &hm LEFT_SHIFT D  &hm LCTRL F   &kp G         &kp H          &hm RCTRL J  &hm RIGHT_SHIFT K  &hm RIGHT_WIN L  &hm RIGHT_ALT SEMI  &kp LEFT_BRACKET
&kp MINUS      &kp Z           &kp X           &kp C             &kp V         &kp B         &kp N          &kp M        &kp COMMA          &kp DOT          &kp FSLH            &kp RIGHT_BRACKET
&kp LCTRL      &kp LEFT_ALT    &kp LEFT_SHIFT  &lt 3 TAB         &lt 2 SPACE   &lt 1 ESCAPE  &kp BACKSPACE  &kp ENTER    &kp ESCAPE         &kp RIGHT_SHIFT  &kp RIGHT_ALT       &kp RCTRL
            >;
        };

        fn {
            bindings = <
&none       &kp F1  &kp F2    &kp F3   &kp F4          &kp F5  &kp F6    &kp F7    &kp F8  &kp F9     &kp F10  &kp F11
&none       &none   &kp HOME  &kp END  &none           &none   &kp N6    &kp N7    &kp N8  &kp N9     &kp N0   &kp F12
&caps_word  &none   &none     &none    &none           &none   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none    &none
&none       &none   &none     &none    &studio_unlock  &none   &kp N1    &kp N2    &kp N3  &kp N4     &kp N5   &none
&none       &none   &none     &none    &none           &none   &none     &none     &none   &none      &none    &none
            >;
        };

        music_bluetooth {
            bindings = <
&none       &none         &none         &none         &none             &none           &none           &none   &none   &none     &none      &none
&kp TAB     &kp INSERT    &kp PG_UP     &kp PG_DN     &bt BT_CLR        &bt BT_CLR_ALL  &kp F6          &kp F7  &kp F8  &kp F9    &kp F10    &kp BSPC
&kp LSHIFT  &kp LSHFT     &kp LEFT_ALT  &none         &kp LEFT_CONTROL  &none           &none           &none   &none   &kp F11   &kp F12    &kp RSHIFT
&kp CLCK    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3      &bt BT_SEL 4    &kp F1          &kp F2  &kp F3  &kp F4    &kp F5     &to 3
&mo 3       &kp SPACE     &to 0         &none         &none             &studio_unlock  &studio_unlock  &none   &none   &kp LGUI  &kp ENTER  &kp ESC
            >;
        };

        mouse {
            bindings = <
&none       &none      &none  &none  &none         &none           &none           &none            &none              &none            &none           &none
&kp TAB     &none      &none  &none  &none         &none           &kp C_MUTE      &kp C_PP         &mkp LCLK          &mkp RCLK        &mkp MCLK       &kp BSPC
&kp LSHIFT  &none      &none  &none  &kp CAPSLOCK  &none           &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_UP       &mmv MOVE_RIGHT  &msc SCRL_UP    &kp RSHIFT
&none       &none      &none  &none  &none         &none           &studio_unlock  &studio_unlock   &msc SCRL_LEFT     &msc SCRL_RIGHT  &msc SCRL_DOWN  &none
&mo 3       &kp SPACE  &to 0  &none  &none         &studio_unlock  &studio_unlock  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp LGUI         &kp ENTER       &kp ESC
            >;
        };

        layer_5 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_6 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_7 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_8 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_9 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_10 {
            bindings = <
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };
    };
};
